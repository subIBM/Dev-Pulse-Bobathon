{
  "@context": "https://schema.org/",
  "@id": "https://ibm.com/devpulse/schema/code-analysis",
  "@type": "CreativeWork",
  "name": "DevPulse Code Analysis Standards",
  "description": "Comprehensive code quality standards, best practices, and architecture patterns for DevPulse sprint orchestrator",
  "author": {
    "@type": "Organization",
    "name": "IBM Consulting"
  },
  "dateCreated": "2026-05-20",
  "version": "1.0",
  "inLanguage": "en",
  "keywords": ["code quality", "software development", "best practices", "technical debt", "code analysis", "refactoring"],
  "about": [
    {
      "@type": "Thing",
      "@id": "#cyclomatic-complexity",
      "name": "Cyclomatic Complexity Limit",
      "description": "Functions should have cyclomatic complexity below 10. High complexity makes code harder to understand, test, and maintain.",
      "category": "complexity",
      "severity": "high",
      "language": "All",
      "exampleGood": "def process_user(user):\n    if not validate_user(user):\n        return None\n    return transform_user(user)",
      "exampleBad": "def process_user(user):\n    if user:\n        if user.age > 18:\n            if user.verified:\n                if user.active:\n                    return user\n    return None",
      "refactoringSuggestion": "Extract validation logic into separate functions",
      "impact": "Reduces bug rate by 40%, improves maintainability",
      "references": "Clean Code by Robert Martin"
    },
    {
      "@type": "Thing",
      "@id": "#nesting-depth",
      "name": "Nesting Depth Limit",
      "description": "Avoid deeply nested code (max 3 levels). Deep nesting reduces readability.",
      "category": "complexity",
      "severity": "medium",
      "language": "All",
      "refactoringSuggestion": "Use early returns, extract methods, use guard clauses",
      "impact": "Improves code review speed by 30%"
    },
    {
      "@type": "Thing",
      "@id": "#function-length",
      "name": "Function Length Limit",
      "description": "Functions should be under 50 lines. Long functions are harder to understand and test.",
      "category": "complexity",
      "severity": "medium",
      "language": "All",
      "refactoringSuggestion": "Break down into smaller, focused functions",
      "impact": "Improves testability and maintainability"
    },
    {
      "@type": "Thing",
      "@id": "#input-validation",
      "name": "Input Validation",
      "description": "Always validate and sanitize user input before processing to prevent injection attacks",
      "category": "security",
      "severity": "critical",
      "language": "All",
      "exampleGood": "def process_input(data):\n    if not isinstance(data, str):\n        raise ValueError('Invalid input')\n    sanitized = sanitize(data)\n    return process(sanitized)",
      "exampleBad": "def process_input(data):\n    return eval(data)",
      "impact": "Prevents 90% of injection attacks",
      "references": "OWASP Top 10"
    },
    {
      "@type": "Thing",
      "@id": "#sql-injection",
      "name": "SQL Injection Prevention",
      "description": "Use parameterized queries, never string concatenation for SQL",
      "category": "security",
      "severity": "critical",
      "language": "Python, JavaScript, Java",
      "exampleGood": "cursor.execute('SELECT * FROM users WHERE id = ?', (user_id,))",
      "exampleBad": "cursor.execute(f'SELECT * FROM users WHERE id = {user_id}')",
      "refactoringSuggestion": "Replace string concatenation with prepared statements",
      "impact": "Eliminates SQL injection vulnerabilities",
      "references": "OWASP SQL Injection Prevention"
    },
    {
      "@type": "Thing",
      "@id": "#sensitive-data",
      "name": "Sensitive Data Exposure",
      "description": "Never log or expose sensitive data like passwords, API keys, or personal information",
      "category": "security",
      "severity": "critical",
      "language": "All",
      "impact": "Prevents data breaches and compliance violations",
      "references": "OWASP Top 10, GDPR"
    },
    {
      "@type": "Thing",
      "@id": "#authentication",
      "name": "Authentication & Authorization",
      "description": "Implement proper authentication and authorization checks for all sensitive operations",
      "category": "security",
      "severity": "critical",
      "language": "All",
      "impact": "Prevents unauthorized access"
    },
    {
      "@type": "Thing",
      "@id": "#type-hints",
      "name": "Type Hints",
      "description": "Use type hints for function parameters and return values to catch type errors early",
      "category": "best_practices",
      "severity": "medium",
      "language": "Python",
      "exampleGood": "def calculate_total(items: List[Item]) -> float:\n    return sum(item.price for item in items)",
      "exampleBad": "def calculate_total(items):\n    return sum(item.price for item in items)",
      "impact": "Catches 60% of type errors before runtime",
      "references": "PEP 484"
    },
    {
      "@type": "Thing",
      "@id": "#docstrings",
      "name": "Docstrings",
      "description": "Write docstrings for all public functions and classes",
      "category": "best_practices",
      "severity": "low",
      "language": "Python",
      "impact": "Improves code documentation and maintainability",
      "references": "PEP 257"
    },
    {
      "@type": "Thing",
      "@id": "#error-handling",
      "name": "Error Handling",
      "description": "Use specific exception types and provide meaningful error messages",
      "category": "best_practices",
      "severity": "high",
      "language": "All",
      "exampleGood": "try:\n    result = process_data(data)\nexcept ValueError as e:\n    logger.error(f'Invalid data: {e}')\n    raise",
      "exampleBad": "try:\n    result = process_data(data)\nexcept:\n    pass",
      "impact": "Improves debugging and error recovery"
    },
    {
      "@type": "Thing",
      "@id": "#naming-conventions",
      "name": "Naming Conventions",
      "description": "Use clear, descriptive names for variables, functions, and classes",
      "category": "best_practices",
      "severity": "medium",
      "language": "All",
      "exampleGood": "user_authentication_service = UserAuthenticationService()",
      "exampleBad": "uas = UAS()",
      "impact": "Improves code readability by 50%",
      "references": "Clean Code, PEP 8"
    },
    {
      "@type": "Thing",
      "@id": "#n-plus-one",
      "name": "Avoid N+1 Queries",
      "description": "Batch database queries instead of querying in loops",
      "category": "performance",
      "severity": "high",
      "language": "All",
      "exampleGood": "users = User.objects.filter(id__in=user_ids).select_related('profile')",
      "exampleBad": "for user_id in user_ids:\n    user = User.objects.get(id=user_id)",
      "refactoringSuggestion": "Use JOIN queries or batch loading",
      "impact": "Reduces database load by 90%, improves response time by 80%"
    },
    {
      "@type": "Thing",
      "@id": "#data-structures",
      "name": "Use Appropriate Data Structures",
      "description": "Choose the right data structure for the task (dict for lookups, set for uniqueness)",
      "category": "performance",
      "severity": "medium",
      "language": "All",
      "exampleGood": "user_ids = set(user_ids)\nif user_id in user_ids:",
      "exampleBad": "user_ids = [...]\nif user_id in user_ids:",
      "impact": "Can improve performance by 10-100x"
    },
    {
      "@type": "Thing",
      "@id": "#lazy-loading",
      "name": "Lazy Loading",
      "description": "Load data only when needed, not all at once",
      "category": "performance",
      "severity": "medium",
      "language": "All",
      "impact": "Reduces memory usage and initial load time"
    },
    {
      "@type": "Thing",
      "@id": "#single-responsibility",
      "name": "Single Responsibility Principle",
      "description": "Each function/class should have one clear responsibility",
      "category": "architecture",
      "severity": "high",
      "language": "All",
      "refactoringSuggestion": "Split large classes/functions into smaller, focused ones",
      "impact": "Improves testability and maintainability",
      "references": "SOLID Principles"
    },
    {
      "@type": "Thing",
      "@id": "#dependency-injection",
      "name": "Dependency Injection",
      "description": "Pass dependencies as parameters instead of creating them internally",
      "category": "architecture",
      "severity": "medium",
      "language": "All",
      "exampleGood": "class UserService:\n    def __init__(self, db_client):\n        self.db = db_client",
      "exampleBad": "class UserService:\n    def __init__(self):\n        self.db = DatabaseClient()",
      "impact": "Improves testability and flexibility"
    },
    {
      "@type": "Thing",
      "@id": "#separation-of-concerns",
      "name": "Separation of Concerns",
      "description": "Separate business logic, data access, and presentation layers",
      "category": "architecture",
      "severity": "high",
      "language": "All",
      "impact": "Improves maintainability and testability",
      "references": "Clean Architecture"
    },
    {
      "@type": "Thing",
      "@id": "#magic-numbers",
      "name": "Magic Numbers",
      "description": "Replace magic numbers with named constants",
      "category": "maintainability",
      "severity": "low",
      "language": "All",
      "exampleGood": "MAX_RETRIES = 3\nif attempts > MAX_RETRIES:",
      "exampleBad": "if attempts > 3:",
      "impact": "Improves code readability and maintainability"
    },
    {
      "@type": "Thing",
      "@id": "#code-comments",
      "name": "Code Comments",
      "description": "Write comments for complex logic, not obvious code",
      "category": "maintainability",
      "severity": "low",
      "language": "All",
      "exampleGood": "# Calculate compound interest: A = P(1 + r/n)^(nt)\nresult = principal * (1 + rate/periods) ** (periods * time)",
      "impact": "Helps future developers understand intent"
    },
    {
      "@type": "Thing",
      "@id": "#dry-principle",
      "name": "DRY Principle",
      "description": "Don't Repeat Yourself - avoid code duplication",
      "category": "maintainability",
      "severity": "medium",
      "language": "All",
      "refactoringSuggestion": "Extract common code into reusable functions",
      "impact": "Reduces maintenance burden by 40%",
      "references": "The Pragmatic Programmer"
    }
  ]
}