# DevPulse Backend Configuration

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# IBM ICA Agentic App Studio Configuration
# Get these from: https://servicesessentials.ibm.com/launchpad/agent-assistant-studio
ICA_AGENT_API_KEY=your_ica_api_key_here
ICA_AGENT_APP_ID=your_agentic_app_id_here
ICA_AGENT_BASE_URL=https://langflow.servicesessentials.ibm.com/api/v1

# IBM Context Studio Configuration
# Get this from your Context Studio context (ctx_xxxxx)
ICA_CONTEXT_STUDIO_CONTEXT_ID=ctx_your_context_id_here

# Legacy IBM API Configuration (Optional - for backward compatibility)
IBM_BOB_API_KEY=your_ibm_bob_api_key_here
IBM_BOB_API_URL=https://api.ibm.com/bob/v1

# Logging
LOG_LEVEL=INFO

# Demo Mode (Set to False to use real ICA APIs)
DEMO_MODE=True